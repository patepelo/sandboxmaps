<?xml version="1.0" encoding="utf-8"?>
<!-- Options of the current map mode: switch mode and its route options. -->
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/margin_base">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half_plus"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_half_plus">
      <FrameLayout
        android:id="@+id/mode_dot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_map_mode_selected">
        <ImageView
          android:id="@+id/mode_dot_icon"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          app:tint="@android:color/white" />
      </FrameLayout>
      <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_half_plus"
        android:layout_weight="1"
        android:textAppearance="@style/MwmTextAppearance.Headline6" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/close_button"
        style="@style/Widget.Material3.Button.UnelevatedButton"
        android:layout_width="@dimen/place_page_top_button"
        android:layout_height="@dimen/place_page_top_button"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="?iconTint"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Button.Round" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/modes_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half_plus"
      android:orientation="horizontal"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base" />
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="@dimen/margin_base"
      android:background="?dividerHorizontal" />
    <com.google.android.material.textview.MaterialTextView
      style="@style/MapModeSectionTitle"
      android:text="@string/map_mode_section_route_options" />
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/route_options_note"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      android:textColor="?android:textColorSecondary" />
    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/route_options"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
