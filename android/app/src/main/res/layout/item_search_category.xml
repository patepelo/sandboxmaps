<?xml version="1.0" encoding="utf-8"?>
<!-- Compact category tile: icon above a short label, four per row on phones (integer/search_category_span). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?selectableItemBackground"
    android:paddingHorizontal="@dimen/margin_quarter"
    android:paddingVertical="@dimen/margin_half">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        tools:srcCompat="@drawable/ic_category_eat"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:ellipsize="end"
        android:hyphenationFrequency="normal"
        android:textAppearance="@style/MwmTextAppearance.Body4"
        android:textColor="?android:textColorPrimary"
        tools:text="@string/category_children"/>
</LinearLayout>
