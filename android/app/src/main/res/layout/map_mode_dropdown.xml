<?xml version="1.0" encoding="utf-8"?>
<!-- Route options of the current map mode, dropping down from the pill. -->
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/map_mode_dropdown"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:visibility="gone"
  style="@style/MapModeDropdownCard">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/margin_half">
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/map_mode_dropdown_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:drawablePadding="@dimen/margin_half"
      android:gravity="center_vertical"
      android:paddingHorizontal="@dimen/margin_base"
      android:paddingVertical="@dimen/margin_half"
      android:textAllCaps="true"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:textColor="?colorAccent" />
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/map_mode_dropdown_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingHorizontal="@dimen/margin_base"
      android:paddingVertical="@dimen/margin_half"
      android:text="@string/map_mode_no_route_options"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      android:textColor="?android:textColorSecondary"
      android:visibility="gone" />
    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/map_mode_dropdown_options"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
