<?xml version="1.0" encoding="utf-8"?>
<!-- Map mode picker: tap a mode to switch the map style and the router; tap the selected one for its options. -->
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/map_mode_picker"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:contentDescription="@string/map_mode"
  app:cardBackgroundColor="?menuBackground"
  app:cardCornerRadius="@dimen/map_mode_picker_radius"
  app:cardElevation="0dp"
  app:contentPadding="4dp"
  app:strokeWidth="0dp">
  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <FrameLayout
      android:id="@+id/mode_walking"
      android:layout_width="@dimen/map_mode_button_size"
      android:layout_height="@dimen/map_mode_button_size"
      android:background="@drawable/bg_map_mode_selected"
      android:contentDescription="@string/mode_walking"
      android:foreground="?selectableItemBackgroundBorderless"
      android:focusable="true"
      android:clickable="true">
      <ImageView
        android:id="@+id/mode_walking_icon"
        android:layout_width="@dimen/map_mode_icon_size"
        android:layout_height="@dimen/map_mode_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_pedestrian" />
      <ImageView
        android:id="@+id/mode_walking_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_map_mode_options_badge"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_more"
        app:tint="?iconTint" />
    </FrameLayout>
    <FrameLayout
      android:id="@+id/mode_cycling"
      android:layout_width="@dimen/map_mode_button_size"
      android:layout_height="@dimen/map_mode_button_size"
      android:background="@drawable/bg_map_mode_selected"
      android:contentDescription="@string/mode_cycling"
      android:foreground="?selectableItemBackgroundBorderless"
      android:focusable="true"
      android:clickable="true">
      <ImageView
        android:id="@+id/mode_cycling_icon"
        android:layout_width="@dimen/map_mode_icon_size"
        android:layout_height="@dimen/map_mode_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_bike" />
      <ImageView
        android:id="@+id/mode_cycling_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_map_mode_options_badge"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_more"
        app:tint="?iconTint" />
    </FrameLayout>
    <FrameLayout
      android:id="@+id/mode_driving"
      android:layout_width="@dimen/map_mode_button_size"
      android:layout_height="@dimen/map_mode_button_size"
      android:background="@drawable/bg_map_mode_selected"
      android:contentDescription="@string/mode_driving"
      android:foreground="?selectableItemBackgroundBorderless"
      android:focusable="true"
      android:clickable="true">
      <ImageView
        android:id="@+id/mode_driving_icon"
        android:layout_width="@dimen/map_mode_icon_size"
        android:layout_height="@dimen/map_mode_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_car" />
      <ImageView
        android:id="@+id/mode_driving_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_map_mode_options_badge"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_more"
        app:tint="?iconTint" />
    </FrameLayout>
    <FrameLayout
      android:id="@+id/mode_public_transport"
      android:layout_width="@dimen/map_mode_button_size"
      android:layout_height="@dimen/map_mode_button_size"
      android:background="@drawable/bg_map_mode_selected"
      android:contentDescription="@string/mode_public_transport"
      android:foreground="?selectableItemBackgroundBorderless"
      android:focusable="true"
      android:clickable="true">
      <ImageView
        android:id="@+id/mode_public_transport_icon"
        android:layout_width="@dimen/map_mode_icon_size"
        android:layout_height="@dimen/map_mode_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_route_planning_metro_40px" />
      <ImageView
        android:id="@+id/mode_public_transport_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_map_mode_options_badge"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_more"
        app:tint="?iconTint" />
    </FrameLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
