<?xml version="1.0" encoding="utf-8"?>
<!-- Route details under the route summary, opened by dragging the panel up (filled by RouteDetailsPanel). -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/route_details"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:visibility="gone">
  <app.organicmaps.widget.MaxHeightScrollView
    android:id="@+id/route_details_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">
    <LinearLayout
      android:id="@+id/route_details_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/margin_half" />
  </app.organicmaps.widget.MaxHeightScrollView>
</LinearLayout>
