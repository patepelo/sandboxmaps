<?xml version="1.0" encoding="utf-8"?>
<!-- One mode in the map mode picker. The selected one is filled with its colour and shows an arrow. -->
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="@dimen/map_mode_button_size"
  android:layout_height="@dimen/map_mode_button_size"
  android:background="@drawable/bg_map_mode_selected"
  android:clickable="true"
  android:focusable="true"
  android:foreground="?selectableItemBackgroundBorderless">
  <ImageView
    android:id="@+id/mode_icon"
    android:layout_width="@dimen/map_mode_icon_size"
    android:layout_height="@dimen/map_mode_icon_size"
    android:layout_gravity="center"
    android:importantForAccessibility="no" />
  <ImageView
    android:id="@+id/mode_arrow"
    android:layout_width="16dp"
    android:layout_height="16dp"
    android:layout_gravity="bottom|center_horizontal"
    android:importantForAccessibility="no"
    android:visibility="gone"
    app:srcCompat="@drawable/ic_expand_more"
    app:tint="@android:color/white" />
</FrameLayout>
